---
/**
 * /works/[slug] — frame 310:1614. Solo desktop.
 *
 * La galleria si compone su un insieme chiuso di due forme, `wide` (10x6) e
 * `half` (5x4), dichiarate nel JSON del progetto. Nel Figma la sequenza e'
 * cucita addosso a Seezy; cosi' la pagina regge un numero qualsiasi di
 * immagini, che e' quanto chiede pagine-interne §7.7.
 *
 * Tutti e tre i progetti hanno testo e galleria. La sequenza di forme la
 * disegna il file per il solo Seezy; gli altri due la riusano, perche' gli slot
 * sono un insieme chiuso e non una fila cucita addosso a un progetto. TAMA e
 * Noranutrizione hanno in piu' un sito online, quindi la loro copertina porta
 * il pulsante "Visit" — che compare **solo** dove c'e' un indirizzo.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import Grid from '../../../components/Grid.astro';
import Block from '../../../components/Block.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Icon from '../../../components/Icon.astro';
import WorkCard from '../../../components/WorkCard.astro';
import VisitButton from '../../../components/VisitButton.astro';
import PrimaryButton from '../../../components/PrimaryButton.astro';
import { headerMap } from '../../../lib/blocks/chrome';
import { galleryAt, workBlocks, workFooter, workTagAt } from '../../../lib/blocks/pages';
import { DEFAULT_LOCALE, LOCALES, pathFor, type Locale } from '../../../i18n';
import { dizionario } from '../../../i18n/dizionario';
import { contenutoProgetto } from '../../../lib/progetti';
import '../../../styles/pages.css';
import '../../../styles/home.css';

/*
 * Le rotte sono il **prodotto** di lingue per progetti.
 *
 * Tre progetti in due lingue fanno sei pagine, e lo slug non cambia: il file
 * md del committente da' gli stessi slug nelle due lingue, quindi /works/seezy
 * e /it/works/seezy sono la stessa pagina in due lingue, non due indirizzi
 * diversi. E' anche quello che rende possibile il comando della lingua: da una
 * si arriva all'altra senza una tabella di corrispondenze.
 */
export async function getStaticPaths() {
  const works = await getCollection('works');
  return LOCALES.flatMap((locale) =>
    works.map((work) => ({
      params: { lang: locale === DEFAULT_LOCALE ? undefined : locale, slug: work.id },
      props: { work, all: works, locale },
    })),
  );
}

interface Props {
  work: CollectionEntry<'works'>;
  all: CollectionEntry<'works'>[];
  locale: Locale;
}

const { work, all, locale } = Astro.props;
const t = dizionario(locale);
const via = (p: string) => pathFor(locale, p);
const testo = contenutoProgetto(work, locale);

const related = all.filter((w) => w.id !== work.id).sort((a, b) => a.data.order - b.data.order).slice(0, 2);
const blocks = work.data.caseStudy?.blocks ?? [];

const tagAt = Object.fromEntries(work.data.tags.map((tag, i) => [tag, workTagAt(i)]));
const galleryPlacements = blocks.map((_, i) => galleryAt(i));
const relatedAt = [workBlocks.workRelatedOne, workBlocks.workRelatedTwo];

const map = {
  ...headerMap,
  ...workBlocks,
  ...Object.fromEntries(Object.entries(tagAt).map(([k, v]) => [`tag-${k}`, v])),
  ...Object.fromEntries(galleryPlacements.map((v, i) => [`gallery-${i}`, v])),
  ...Object.fromEntries(related.map((w, i) => [`related-${w.id}`, relatedAt[i]])),
  ...workFooter,
};
---

<Base
  locale={locale}
  percorso={`/works/${work.id}`}
  title={`${work.data.title} — Emanuele Giovanili`}
  description={testo.excerpt}
>
  <Grid map={map} tiers={['base', 'md', 'lg']} class="work-grid">
    <Header current="/works" locale={locale} />

    <Block at={workBlocks.workCover} class="media-block" clip>
      <Picture
        data-reveal
        src={work.data.cover}
        alt={testo.coverAlt}
        widths={[960, 1400, 1920]}
        sizes="(min-width: 1200px) 83vw, 100vw"
        formats={['avif', 'webp']}
        loading="eager"
      />
    </Block>

    {/* Solo dove il progetto ha un sito online. Seezy non ce l'ha, e la sua
        copertina resta quella del frame. */}
    {work.data.liveUrl && (
      <VisitButton at={workBlocks.workVisit} href={work.data.liveUrl} label={work.data.title} />
    )}

    {work.data.tags.map((tag) => (
      <Block at={tagAt[tag]} class="work-tag" clip>
        {tag}
      </Block>
    ))}

    <Block at={workBlocks.workTitle} class="page-title" clip>
      <h1 class="t-display t-display--page">{work.data.title}</h1>
    </Block>

    {/*
      A base il testo non ci sta, e il file lo dice: 397:747 e' troncato con i
      puntini e sotto c'e' "Keep reading" in viola (397:762). A desktop il
      blocco e' alto sei righe e il testo ci sta intero, quindi il comando non
      serve e sparisce.

      `<details>` e non un bottone con del JavaScript: aprire e chiudere un
      testo e' esattamente quello che questo elemento fa, lo fa senza script e
      lo fa anche se lo script non arriva. Il riassunto e' il comando, e il
      testo troncato sta **dentro** al riassunto, cosi' quello che si legge da
      chiuso e' gia' il testo vero e non un'anteprima scritta a parte.
    */}
    {
      work.data.caseStudy && (
        <Block at={workBlocks.workBody} class="work-body" clip>
          <details class="work-body__more">
            <summary class="work-body__summary">
              <div class="work-body__text">
                {testo.body.map((paragrafo) => (
                  <p class="t-body">{paragrafo}</p>
                ))}
              </div>
              <span class="work-body__cue">{t.comune.progetto.continua}</span>
            </summary>
          </details>
        </Block>
      )
    }

    {
      blocks.map((image, i) => (
        <Block at={galleryPlacements[i]} class="media-block" clip>
          <Picture
            data-reveal
            src={image.src}
            alt={testo.blockAlts[i] ?? image.alt}
            widths={[640, 960, 1400, 1920]}
            sizes="(min-width: 1200px) 83vw, 100vw"
            formats={['avif', 'webp']}
            loading="lazy"
          />
        </Block>
      ))
    }

    <Block at={workBlocks.workRelatedTitle} class="related-title" clip>
      <h2 class="t-display t-display--page">{t.comune.progetto.correlati}</h2>
    </Block>

    <Block at={workBlocks.workRelatedFlame} class="icon-cell" clip>
      <Icon name="flame" />
    </Block>

    {
      related.map((item, i) => (
        <Block
          at={relatedAt[i]}
          as="a"
          href={via(`/works/${item.id}`)}
          class="works-card"
          clip
        >
          <WorkCard work={item} sizes="(min-width: 1200px) 42vw, 100vw" locale={locale} />
        </Block>
      ))
    }

    <PrimaryButton at={workBlocks.workViewAll} label={t.comune.progetto.vediTutti} href={via('/works')} />

    <Footer at={workFooter} current="/works" locale={locale} />
  </Grid>
</Base>
