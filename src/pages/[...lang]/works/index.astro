---
/**
 * /works — frame 310:1270. Solo desktop.
 *
 * I contatori dei filtri sono calcolati dalla collection, mai scritti a mano.
 * Nel Figma "All" dice 4 con tre progetti in elenco: gli altri tre contatori
 * (Web Design 2, Branding 2, Product 1) coincidono invece esattamente con i
 * tre progetti reali. E' "All" a essere rimasto indietro, vedi NOTES.md §3.1.
 */
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Grid from '../../../components/Grid.astro';
import Block from '../../../components/Block.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Icon from '../../../components/Icon.astro';
import WorkCard from '../../../components/WorkCard.astro';
import ContactSection from '../../../components/ContactSection.astro';
import { headerMap } from '../../../lib/blocks/chrome';
import {
  worksBlocks,
  worksCardAt,
  worksCardRow,
  worksFilterAt,
  worksFilterStates,
  worksFooter,
} from '../../../lib/blocks/pages';
import { deriveRows } from '../../../lib/layout';
import { WORK_TAGS } from '../../../content.config';
import '../../../styles/pages.css';
import '../../../styles/home.css';

import { localeRoutes, pathFor } from '../../../i18n';
import { dizionario } from '../../../i18n/dizionario';

export function getStaticPaths() {
  return localeRoutes;
}

const { locale } = Astro.props;
const t = dizionario(locale);
const via = (p: string) => pathFor(locale, p);

const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);

const cardAt = Object.fromEntries(works.map((w, i) => [w.id, worksCardAt(i)]));
const filterAt = Object.fromEntries(WORK_TAGS.map((_, i) => [i, worksFilterAt(i + 1)]));

const map = {
  ...headerMap,
  ...worksBlocks,
  ...Object.fromEntries(Object.entries(cardAt).map(([k, v]) => [`card-${k}`, v])),
  ...Object.fromEntries(WORK_TAGS.map((_, i) => [`filter-${i}`, filterAt[i]])),
  filterAll: worksFilterAt(0),
  ...worksFooter,
};

/*
 * I quattro stati del filtro, calcolati al build.
 *
 * `rowsFull` e' l'ultima riga della pagina con tutte le card: da li' ogni stato
 * toglie quattro righe per card nascosta. Si legge dalla mappa invece di
 * scriverlo, per la stessa ragione per cui `--rows` non si scrive a mano: se un
 * blocco scende, il numero segue.
 */
const rowsFull = deriveRows(map);
const states = worksFilterStates(
  works.map((w) => ({ id: w.id, tags: w.data.tags })),
  WORK_TAGS,
  rowsFull,
  t.works.tutti,
);

/**
 * La riga di una card, stato per stato: il posto che occupa fra quelle visibili.
 *
 * Le card **si ricompattano**, non traslano: se nascondo la prima, la seconda
 * prende il primo posto. Quindi ognuna porta una riga per ogni stato in cui si
 * vede, calcolata qui.
 */
const cardStyle = (id: string) =>
  states
    .filter((st) => st.ids.includes(id))
    .flatMap((st) =>
      (['base', 'md', 'lg'] as const).map(
        (tier) => `--row-${st.slug}-${tier}:${worksCardRow(st.ids.indexOf(id), tier)}`,
      ),
    )
    .join(';');

/**
 * Le regole che accendono uno stato.
 *
 * Toccano `--row` e `--rows`, non `--row-lg` e `--rows-lg`: quelli stanno
 * nell'attributo `style` dei blocchi, e uno stile inline vince su qualunque
 * selettore. `--row` invece lo assegna grid.css con la specificita' di una
 * classe, e qui si arriva con una classe piu' un attributo.
 *
 * Sotto le card lo scostamento e' **lo stesso per tutti**, quindi basta un
 * numero per stato e un `calc` sulla riga che il blocco ha gia': misurato che
 * `grid-row-start: calc(20 - 8)` risolve a 12, cioe' che un `calc` e' accettato
 * dove sta un numero di linea.
 */
const perTier = (tier: 'base' | 'md' | 'lg') =>
  `.works-grid [data-flow]{--row:calc(var(--row-${tier}) - var(--shift, 0))}` +
  states
    .map(
      (st) =>
        `.works-grid[data-filter="${st.slug}"]{--rows:${st.rows[tier]};--shift:${st.shift[tier]}}` +
        `.works-grid[data-filter="${st.slug}"] .works-card{--row:var(--row-${st.slug}-${tier})}`,
    )
    .join('');

/*
 * Una serie di regole per tier, dentro le stesse media query della griglia.
 *
 * Da quando /works ha anche un tier base, "quanto sale la pagina quando filtro"
 * non e' piu' un numero solo: a mobile una card vale dodici righe e a desktop
 * quattro. Scriverne uno solo vorrebbe dire pagina giusta a una larghezza e
 * sbagliata all'altra, e per giunta in silenzio — la griglia resterebbe
 * allineata, sarebbe solo alta il doppio del dovuto.
 */
const filterCss =
  perTier('base') +
  `@media (min-width:720px){${perTier('md')}}` +
  `@media (min-width:1200px){${perTier('lg')}}`;
---

<style set:html={filterCss}></style>

<Base locale={locale} percorso="/works" title={t.works.titoloPagina} description={t.works.descrizione}>
  <Grid map={map} tiers={['base', 'md', 'lg']} class="works-grid" data-filter="all">
    <Header current="/works" locale={locale} />

    <Block at={worksBlocks.worksTitle} class="page-title" clip>
      <h1 class="t-display t-display--page">{t.works.titolo}</h1>
    </Block>

    <Block at={worksBlocks.worksFlame} class="icon-cell" clip>
      <Icon name="flame" />
    </Block>

    {/*
      I filtri esistono due volte, e non e' una svista.
      
      A desktop sono quattro blocchi della griglia (310:1507); a base il file li
      mette in una riga larga 627 dentro 390 (397:389), cioe' dentro un
      contenitore che scorre — e li' non possono essere blocchi, perche' un
      blocco sta sulla griglia. E' la stessa scelta gia' fatta per la ricetta di
      /about: due costruzioni, una per tier, e ognuna sparisce quando non e' la
      sua (D133).
      
      Il JavaScript del filtro li trova tutti e due i gruppi e li tiene
      allineati, perche' interroga per classe e non per posizione.
    */}
    <Block at={worksBlocks.worksFilterBar} surface="bare" class="filter-bar">
      <div class="filter-bar__track">
        {states.map((state, i) => (
          <button
            type="button"
            class="work-filter filter-tab"
            aria-pressed={i === 0 ? 'true' : 'false'}
            data-filter={state.slug}
          >
            <span class="work-filter__label">{state.label}</span>
            <span class="work-filter__count">{state.ids.length}</span>
            <span class="hover-fill" aria-hidden="true">
              <span class="work-filter__label">{state.label}</span>
              <span class="work-filter__count">{state.ids.length}</span>
            </span>
          </button>
        ))}
      </div>
    </Block>

    {
      states.map((state, i) => (
        <Block
          at={i === 0 ? worksFilterAt(0) : filterAt[i - 1]}
          as="button"
          type="button"
          class="work-filter"
          aria-pressed={i === 0 ? 'true' : 'false'}
          data-filter={state.slug}
          clip
        >
          <span class="work-filter__label">{state.label}</span>
          <span class="work-filter__count">{state.ids.length}</span>
          {/* La copia nel colore d'arrivo, come sui bottoni: adesso che i
              filtri fanno qualcosa, devono anche rispondere al puntatore. */}
          <span class="hover-fill" aria-hidden="true">
            <span class="work-filter__label">{state.label}</span>
            <span class="work-filter__count">{state.ids.length}</span>
          </span>
        </Block>
      ))
    }

    {
      works.map((work, i) => (
        <Block
          at={cardAt[work.id]}
          as="a"
          href={via(`/works/${work.id}`)}
          class="works-card"
          data-card={work.id}
          style={cardStyle(work.id)}
          clip
        >
          <WorkCard work={work} eager={i === 0} locale={locale} />
        </Block>
      ))
    }

    <ContactSection
      at={{
        form: worksBlocks.worksContactForm,
        cta: worksBlocks.worksContactCta,
        send: worksBlocks.worksContactSend,
      }}
      flow
    />

    <Footer at={worksFooter} current="/works" locale={locale} flow />
  </Grid>
</Base>

<script>
  import { startWorksFilter } from '../../../scripts/works-filter';

  startWorksFilter();
</script>
