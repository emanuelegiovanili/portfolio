---
/**
 * /about — frame 274:1855.
 *
 * Solo desktop: sotto 1200px non esiste un disegno. Su questo nodo
 * `get_metadata` restituisce un frame vuoto; i dati vengono da
 * `get_design_context`.
 */
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Grid from '../../components/Grid.astro';
import Block from '../../components/Block.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ContactSection from '../../components/ContactSection.astro';
import Icon from '../../components/Icon.astro';
import { headerMap } from '../../lib/blocks/chrome';
import { aboutBlocks, aboutFooter, tagSlug } from '../../lib/blocks/pages';
import { SETTORI } from '../../data/about';
import { WORK_TAGS } from '../../content.config';
import portrait from '../../assets/about/portrait.jpg';
import '../../styles/pages.css';

import { localeRoutes, pathFor } from '../../i18n';
import { dizionario } from '../../i18n/dizionario';
import Righe from '../../components/Righe.astro';

export function getStaticPaths() {
  return localeRoutes;
}

const { locale } = Astro.props;
const t = dizionario(locale);
const via = (p: string) => pathFor(locale, p);

const map = { ...headerMap, ...aboutBlocks, ...aboutFooter };

/*
 * Le tre schede degli ambiti, ognuna col proprio posto sulla griglia.
 *
 * La guardia e' la stessa di home: `includes` non compila se un tag esce da
 * `WORK_TAGS`, e se qualcuno allenta i tipi la build si ferma comunque qui. Una
 * scheda che porta a un ambito che /works non conosce e' un link a una pagina
 * vuota, e nessuno se ne accorgerebbe guardando la pagina.
 */
const settori = [aboutBlocks.sectorOne, aboutBlocks.sectorTwo, aboutBlocks.sectorThree].map(
  (at, i) => ({ at, ...SETTORI[i], ...t.about.settori[i] }),
);

/*
 * Due guardie, non una.
 *
 * La prima e' quella di sempre: una scheda non puo' puntare a un ambito che
 * /works non conosce. La seconda e' nuova e serve ai dizionari: struttura e
 * copy stanno in due file diversi e si accoppiano per **posizione**, quindi
 * se una delle due liste cambia lunghezza le schede si disallineano in
 * silenzio — l'icona di Branding sopra il testo di Web Design. Meglio una
 * build che si ferma.
 */
if (SETTORI.length !== t.about.settori.length) {
  throw new Error('about: i settori nel dizionario non sono quanti quelli in SETTORI.');
}

if (SETTORI.some((settore) => !WORK_TAGS.includes(settore.tag))) {
  throw new Error('/about: una scheda degli ambiti punta a un ambito che /works non conosce.');
}
---

<Base locale={locale} percorso="/about" title={t.about.titoloPagina} description={t.about.descrizione}>
  <Grid map={map} tiers={["base", "md", "lg"]} class="about-grid">
    <Header current="/about" locale={locale} />

    <Block at={aboutBlocks.aboutTitle} class="page-title is-over" clip>
      <h1 class="t-display t-display--page">{t.about.titolo}</h1>
    </Block>

    <Block at={aboutBlocks.aboutBioLabel} class="label-cell" clip>
      <span class="t-title">{t.about.bioEtichetta}</span>
    </Block>

    <Block at={aboutBlocks.aboutPortrait} surface="bare" class="media-block" clip>
      <Picture
        data-reveal
        src={portrait}
        alt={t.about.ritrattoAlt}
        widths={[480, 960]}
        sizes="(min-width: 1200px) 33vw, 100vw"
        formats={['avif', 'webp']}
        loading="eager"
      />
    </Block>

    <Block
      at={aboutBlocks.aboutBio}
      class="prose"
      clip
      data-known-overflow="274:2063 — misurato: 22px di avanzo a 1440, 12 di sforo a 1200, dove le colonne si stringono e il testo guadagna una riga"
    >
      {t.about.bio.map((paragrafo) => <p class="t-body">{paragrafo}</p>)}
    </Block>

    <Block at={aboutBlocks.aboutPin} class="icon-cell" clip>
      <Icon name="map-pin" />
    </Block>

    <Block at={aboutBlocks.aboutLocation} class="text-cell" clip>
      <p class="t-body">{t.about.luogo}</p>
    </Block>

    <Block at={aboutBlocks.aboutRemote} class="text-cell text-cell--center" clip>
      <p class="t-meta">{t.about.remoto}</p>
    </Block>

    <Block at={aboutBlocks.recipeIcon} class="icon-cell" clip>
      <Icon name="chef-hat" />
    </Block>

    <Block at={aboutBlocks.recipeTitle} class="section-title" clip>
      <h2 class="t-display t-display--section"><Righe testo={t.about.ricettaTitolo} /></h2>
    </Block>

    <Block at={aboutBlocks.recipeFlame} class="icon-cell" clip>
      <Icon name="flame" />
    </Block>

    {/*
      A base e md le tre schede stanno in una riga sola che scorre di lato
      (356:622): 21 colonne dentro a 10. Le tre qui sotto hanno solo `lg`,
      quindi spariscono da sole sotto i 1200, e questa sparisce sopra.

      Una scheda alla volta, larga quanto la finestra: nessuna viene tagliata.
      I fili li disegna il blocco, perche' la scheda visibile lo riempie
      esattamente. Lo scorrimento sta sul binario **dentro** al blocco:
      `overflow` su un blocco gli ritaglia i quattro fili (D103, D107).
    */}
    {/*
      "What I actually do": tre ambiti, e ognuno porta a /works gia' filtrato.

      E' la stessa costruzione delle card del mix in home, e non per pigrizia:
      il riempimento dell'hover e' una **copia** di quello che c'e' sotto, e
      tenerne due varianti vuol dire tenerne allineate due per sempre. La
      copia sta in `.hover-fill`, sale dal basso — `clip-path: inset(var(--hover) 0 0 0)`
      con `--hover` da 100% a 0 — ed e' quello che il committente ha chiesto.

      La freccia e' solo a base e md: nel file desktop non c'e' (397:936), a
      mobile si' (400:996). Ha senso — su un telefono l'hover non esiste, e
      senza freccia niente direbbe che la scheda porta da qualche parte.
    */}
    <Block at={aboutBlocks.whatTitle} class="section-title" clip>
      <h2 class="t-display t-display--page what-title"><Righe testo={t.about.cosaTitolo} /></h2>
    </Block>

    <Block at={aboutBlocks.whatIcon} class="icon-cell" clip>
      <Icon name="cooking-pot" />
    </Block>

    {
      settori.map((settore) => (
        <Block
          at={settore.at}
          as="a"
          href={`${via('/works')}?filter=${tagSlug(settore.tag)}`}
          class="sector-card"
          clip
          data-known-overflow="397:936, 397:930 e 397:942 — le schede sono 3x3 nel file e a 1440 il testo ci sta. Fra 1200 e 1279 la cella si stringe ma il corpo tocca il minimo di 14px e smette di scalare: su questa macchina avanzano 10px, in CI ne mancano 12. E' lo stesso B14 delle schede della ricetta, e la differenza fra le due misure sono le metriche dei font del runner."
        >
          <span class="sector-card__head">
            <Icon name={settore.icon} />
            <Icon name="arrow-up-right" class="sector-card__arrow" />
          </span>
          <span class="sector-card__title">{settore.titolo}</span>
          <span class="t-body sector-card__body">{settore.corpo}</span>
          <span class="hover-fill" aria-hidden="true">
            <span class="sector-card__head">
              <Icon name={settore.icon} />
              <Icon name="arrow-up-right" class="sector-card__arrow" />
            </span>
            <span class="sector-card__title">{settore.titolo}</span>
            <span class="t-body sector-card__body">{settore.corpo}</span>
          </span>
        </Block>
      ))
    }

    <Block at={aboutBlocks.recipeSteps} surface="bare" class="recipe-steps">
      <div class="recipe-steps__track">
        {t.about.ricetta.map((passo) => (
          <article class="recipe-steps__card">
            <h3 class="recipe-card__title">{passo.heading}</h3>
            <p class="t-body recipe-card__body">{passo.corpo}</p>
          </article>
        ))}
      </div>
    </Block>

    {/*
      Le tre schede a desktop. Fino al testo precedente sforavano fra 1200 e
      1279 ed erano dichiarate con `data-known-overflow`: col testo nuovo, che
      perde il titolo breve e una riga, avanzano +42,2px a 1200 e +59,1px a
      1440, cioe' due righe di corpo. La dichiarazione e' stata tolta di
      proposito: lasciarla direbbe il falso, e tolta e' `verify:grid` che
      urla se un domani il testo cresce di nuovo. Misura in D147.
    */}
    <Block
      at={aboutBlocks.recipeOne}
      class="recipe-card"
      clip
    >
      <h3 class="recipe-card__title">{t.about.ricetta[0].heading}</h3>
      <p class="t-body recipe-card__body">{t.about.ricetta[0].corpo}</p>
    </Block>

    <Block
      at={aboutBlocks.recipeTwo}
      class="recipe-card"
      clip
    >
      <h3 class="recipe-card__title">{t.about.ricetta[1].heading}</h3>
      <p class="t-body recipe-card__body">{t.about.ricetta[1].corpo}</p>
    </Block>

    <Block
      at={aboutBlocks.recipeThree}
      class="recipe-card"
      clip
    >
      <h3 class="recipe-card__title">{t.about.ricetta[2].heading}</h3>
      <p class="t-body recipe-card__body">{t.about.ricetta[2].corpo}</p>
    </Block>

    {/* Stessa sezione di home, works e contact: un solo form nel sito. */}
    <ContactSection
      at={{ form: aboutBlocks.aboutForm, cta: aboutBlocks.aboutCta, send: aboutBlocks.aboutSend }}
    />

    <Footer at={aboutFooter} current="/about" locale={locale} />
  </Grid>
</Base>
