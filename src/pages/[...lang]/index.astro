---
/**
 * Home.
 *
 * L'unica pagina con tutti e tre i tier. Le posizioni vengono da
 * src/lib/blocks/home.ts, che le tiene lette dai tre frame; qui c'e' solo il
 * contenuto e la struttura.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Grid from '../../components/Grid.astro';
import Block from '../../components/Block.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import Righe from '../../components/Righe.astro';
import SquareButton from '../../components/SquareButton.astro';
import PrimaryButton from '../../components/PrimaryButton.astro';
import ContactSection from '../../components/ContactSection.astro';
import WorksCarousel from '../../components/home/WorksCarousel.astro';
import Testimonials from '../../components/home/Testimonials.astro';
import { headerMap } from '../../lib/blocks/chrome';
import { homeBlocks, homeFooter } from '../../lib/blocks/home';
import { tagSlug } from '../../lib/blocks/pages';
import { WORK_TAGS } from '../../content.config';
import { testimonialCompleti } from '../../data/testimonials';
import { localeRoutes, pathFor } from '../../i18n';
import { dizionario } from '../../i18n/dizionario';
import '../../styles/home.css';

export function getStaticPaths() {
  return localeRoutes;
}

const { locale } = Astro.props;
const t = dizionario(locale);
const via = (percorso: string) => pathFor(locale, percorso);

const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);

const map = { ...headerMap, ...homeBlocks, ...homeFooter };

/**
 * Le tre skill card. L'icona e l'etichetta vengono da 262:937, 262:939, 262:930.
 *
 * Ognuna porta a /works gia' filtrata sul proprio ambito, su richiesta del
 * committente: erano tre riquadri che descrivevano cosa faccio e finivano li'.
 *
 * `tag` e' il tag del progetto, non l'etichetta: nel Figma la card dice
 * "Product Design" e il filtro dice "Product". Il tipo lo tiene dentro
 * `WORK_TAGS`, quindi una card che punta a un ambito inesistente non arriva
 * alla build.
 */
const SKILLS = [
  { at: homeBlocks.skillProduct, icon: 'tablet-smartphone', label: t.home.skillProduct, tag: 'Product' },
  { at: homeBlocks.skillWeb, icon: 'app-window', label: t.home.skillWeb, tag: 'Web Design' },
  { at: homeBlocks.skillBranding, icon: 'swatch-book', label: t.home.skillBranding, tag: 'Branding' },
] as const;

// La guardia e' doppia: `includes` non compila se un tag esce da WORK_TAGS, e se
// qualcuno allenta i tipi la build si ferma comunque qui.
if (SKILLS.some((skill) => !WORK_TAGS.includes(skill.tag))) {
  throw new Error('home: una skill card punta a un ambito che /works non conosce.');
}
---

<Base locale={locale} percorso="/" title={t.home.titoloPagina} description={t.home.descrizione}>
  <Grid map={map}>
    <Header current="/" locale={locale} />

    <Block
      at={homeBlocks.heroText}
      class="hero-text"
      clip
      data-known-overflow="314:2437 — a base il titolo a 72px chiede 125px dentro 116 di spazio utile"
    >
      <h1 class="t-display hero-text__title"><Righe testo={t.home.heroTitolo} /></h1>
    </Block>

    <Block at={homeBlocks.heroDescription} class="hero-desc" clip>
      <div class="hero-desc__copy">
        <p class="hero-desc__lead"><Righe testo={t.home.heroLead} /></p>
        <p class="t-body hero-desc__body">{t.home.heroCorpo}</p>
      </div>

      {/* Due righe in inglese, una sola in italiano: il frame italiano non
          dice "Working remotely". E' una differenza di contenuto, non una
          traduzione mancata, e qui la regge l'array. */}
      <p class="t-meta hero-desc__location"><Righe testo={t.home.heroLuogo} /></p>

    </Block>

    <SquareButton at={homeBlocks.heroProfile} variant="profile" label={t.home.heroProfilo} href={via('/about')} />
    <PrimaryButton at={homeBlocks.heroDiscover} label={t.home.heroScopri} href="#about" />

    <Block at={homeBlocks.marquee} surface="bare" class="marquee" data-bleed>
      <div class="marquee__bleed">
        <ul class="marquee__track">
          {t.home.servizi.map((servizio) => <li class="marquee__item">{servizio}</li>)}
        </ul>
      </div>
    </Block>

    <Block
      at={homeBlocks.about}
      class="about-section"
      id="about"
      clip
      data-known-overflow="314:2325 — sotto i 390 il corpo del testo guadagna righe che il blocco non ha"
    >
      <h2 class="t-display about-section__title"><Righe testo={t.home.aboutTitolo} /></h2>
      <p class="t-body about-section__body">{t.home.aboutCorpo}</p>
    </Block>

    {
      SKILLS.map((skill) => (
        <Block
          at={skill.at}
          as="a"
          href={`${via('/works')}?filter=${tagSlug(skill.tag)}`}
          class="skill-card"
          clip
        >
          <Icon name={skill.icon} />
          <p class="skill-card__label">{skill.label}</p>
          {/* La copia nel colore d'arrivo, come sui bottoni: adesso che la card
              e' un link, deve anche rispondere al puntatore. `span` e non `p`
              perche' un paragrafo dentro uno span non e' markup valido; dentro
              un contenitore flex si comporta allo stesso modo. */}
          <span class="hover-fill" aria-hidden="true">
            <Icon name={skill.icon} />
            <span class="skill-card__label">{skill.label}</span>
          </span>
        </Block>
      ))
    }

    <Block
      at={homeBlocks.worksSection}
      class="works-section"
      clip
      data-known-overflow="314:2336 — a base titolo piu' didascalia chiedono 57px dentro 38 di spazio utile"
    >
      <h2 class="t-display works-section__title"><Righe testo={t.home.lavoriTitolo} /></h2>
      {/* Il frame italiano non ha didascalia: stringa vuota, blocco assente. */}
      {t.home.lavoriDidascalia && <p class="works-section__caption">{t.home.lavoriDidascalia}</p>}
    </Block>

    <PrimaryButton at={homeBlocks.worksViewAll} label={t.home.lavoriVediTutti} href={via('/works')} />

    <WorksCarousel
      at={{
        card: homeBlocks.worksImage,
        pagination: homeBlocks.worksPagination,
        prev: homeBlocks.worksPrev,
        next: homeBlocks.worksNext,
      }}
      works={works}
      locale={locale}
    />

    <Block
      at={homeBlocks.testimonialsSection}
      class="testimonials-section"
      clip
      data-known-overflow="314:2372 — a base il titolo va su tre righe: 88px dentro 77 di spazio utile"
    >
      <h2 class="t-display testimonials-section__title"><Righe testo={t.home.testimonialTitolo} /></h2>
    </Block>

    <Block at={homeBlocks.testimonialsIcon} class="wink" clip>
      <span aria-hidden="true">;)</span>
      <span class="visually-hidden">{t.home.occhiolino}</span>
    </Block>

    <Testimonials
      at={{
        row: homeBlocks.testimonialsRow,
        details: homeBlocks.testimonialsContainer,
        prev: homeBlocks.testimonialsPrev,
        next: homeBlocks.testimonialsNext,
      }}
      items={testimonialCompleti(locale)}
      locale={locale}
    />

    <ContactSection
      at={{
        form: homeBlocks.contactForm,
        cta: homeBlocks.contactCta,
        send: homeBlocks.contactSend,
      }}
      locale={locale}
    />

    <Footer at={homeFooter} current="/" locale={locale} />
  </Grid>
</Base>
