---
/**
 * /contact — frame 312:1995. Solo desktop, e senza CTA Section.
 */
import Base from '../../layouts/Base.astro';
import Grid from '../../components/Grid.astro';
import Block from '../../components/Block.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import ContactSection from '../../components/ContactSection.astro';
import { headerMap } from '../../lib/blocks/chrome';
import { contactBlocks, contactFooter } from '../../lib/blocks/pages';
import '../../styles/pages.css';

import { localeRoutes } from '../../i18n';
import { dizionario } from '../../i18n/dizionario';

export function getStaticPaths() {
  return localeRoutes;
}

const { locale } = Astro.props;
const t = dizionario(locale);

const map = { ...headerMap, ...contactBlocks, ...contactFooter };
---

<Base locale={locale} percorso="/contact" title={t.contatti.titoloPagina} description={t.contatti.descrizione}>
  <Grid map={map} tiers={['lg']}>
    <Header current="/contact" locale={locale} />

    <Block at={contactBlocks.contactTitle} class="page-title" clip>
      <h1 class="t-display t-display--page">{t.contatti.titolo}</h1>
    </Block>

    <Block at={contactBlocks.contactIcon} class="icon-cell" clip>
      <Icon name="send" />
    </Block>

    {/*
      Telefono e indirizzo, 423:147.

      **Tre celle, non quattro.** Nel file questo blocco e' largo 480 (colonne
      2-5) e l'icona `send` sta a colonna 5, riga 5: due blocchi bordati sulla
      stessa cella, cioe' due fili sulla stessa linea e la regola zero rotta in
      quel punto. E' uno scostamento della famiglia di §3.3, e si risolve come
      gli altri — riportando sulla griglia — con il blocco a tre celle e
      l'icona che resta dov'era gia' nel disegno inglese.

      Sono due link, non due righe di testo: su un telefono il numero si tocca
      e parte la chiamata, e l'indirizzo apre il programma di posta. Scriverli
      come testo morto vorrebbe dire far copiare a mano un numero a chi sta
      leggendo dal telefono.
    */}
    <Block at={contactBlocks.contactDetails} class="contact-details" clip>
      <a class="contact-details__link" href={`tel:${t.contatti.telefono.replace(/\s/g, '')}`}>
        {t.contatti.telefono}
      </a>
      <a class="contact-details__link" href={`mailto:${t.contatti.email}`}>{t.contatti.email}</a>
    </Block>

    <ContactSection at={{ form: contactBlocks.contactForm, send: contactBlocks.contactSend }} locale={locale} />

    <Footer at={contactFooter} current="/contact" locale={locale} />
  </Grid>
</Base>
