---
/**
 * Pagina di diagnosi, temporanea.
 *
 * Su Safari i bordi dei blocchi non si vedono, e da questa sessione Safari non
 * e' verificabile: il motore WebKit non e' scaricabile (NOTES.md B23). Questa
 * pagina fa le domande al posto mio. Si apre sul dispositivo, si fotografa, e
 * la risposta e' nella foto.
 *
 * Ogni prova isola **un pezzo** del meccanismo con cui il sito disegna il filo
 * attorno a un blocco, dal piu' semplice al piu' vicino al vero. La prima che
 * non ha il contorno viola e' quella che rompe.
 *
 * Va tolta appena la causa e' nota.
 */
import Base from '../layouts/Base.astro';
import '../styles/grid.css';

const PROVE = [
  {
    id: 'a',
    nome: 'A · bordo normale',
    cosa: 'Un border CSS, niente pseudo-elemento. Se manca questo, manca tutto.',
  },
  {
    id: 'b',
    nome: 'B · pseudo con misure fisse',
    cosa: 'Lo pseudo-elemento c’e’, ma le sue distanze sono numeri scritti a mano.',
  },
  {
    id: 'c',
    nome: 'C · pseudo con calc semplice',
    cosa: 'Le distanze vengono da calc() su una variabile, senza altre funzioni dentro.',
  },
  {
    id: 'd',
    nome: 'D · pseudo con calc + variabile numerica',
    cosa: 'Come C, ma dentro al calc c’e’ una somma con una seconda variabile.',
  },
  {
    id: 'e',
    nome: 'E · pseudo con max() annidato dentro calc()',
    cosa: 'Esattamente quello che fa il sito. E’ il mio sospetto numero uno.',
  },
  {
    id: 'f',
    nome: 'F · il filo vero, come sul sito',
    cosa: 'Un blocco vero con la regola vera, copiata senza cambiare niente.',
  },
];
---

<Base title="Diagnostica" description="Pagina temporanea di diagnosi.">
  <main class="diag">
    <h1>Diagnostica bordi</h1>
    <p class="diag__intro">
      Ogni riquadro qui sotto dovrebbe avere un <strong>contorno viola</strong>. La prima prova
      senza contorno e&rsquo; quella che rompe. Fotografa tutta la pagina, testo compreso.
    </p>

    {
      PROVE.map((prova) => (
        <section class="diag__caso">
          <h2>{prova.nome}</h2>
          <p class="diag__cosa">{prova.cosa}</p>
          <div class={`diag__box diag__box--${prova.id}`} data-prova={prova.id} />
          <pre class="diag__esito" data-esito={prova.id}>misuro&hellip;</pre>
        </section>
      ))
    }

    <section class="diag__caso">
      <h2>Ambiente</h2>
      <pre class="diag__esito" data-ambiente>misuro&hellip;</pre>
    </section>

    <section class="diag__caso">
      <h2>Errori JavaScript</h2>
      <pre class="diag__esito" data-errori>nessuno finora</pre>
    </section>
  </main>
</Base>

<style is:global>
  .diag {
    max-width: 44rem;
    margin: 0 auto;
    padding: 24px 16px 64px;
    font-family: system-ui, sans-serif;
    font-size: 15px;
    line-height: 1.5;
    color: #111;
  }

  .diag h1 {
    font-size: 22px;
  }

  .diag h2 {
    margin-bottom: 2px;
    font-size: 16px;
  }

  .diag__intro,
  .diag__cosa {
    margin: 0 0 10px;
    color: #444;
  }

  .diag__caso {
    margin-block: 26px;
  }

  .diag__esito {
    margin: 8px 0 0;
    padding: 8px 10px;
    overflow-x: auto;
    background: #f1f0f4;
    font-size: 12px;
    line-height: 1.45;
    white-space: pre-wrap;
    word-break: break-word;
  }

  /* I riquadri di prova: 120x56, contorno viola da 2px per vedersi bene. */
  .diag__box {
    position: relative;
    width: 120px;
    height: 56px;
    background: #fff;
  }

  .diag__box::after {
    content: '';
    position: absolute;
    background-image:
      linear-gradient(#5b2ff5, #5b2ff5),
      linear-gradient(#5b2ff5, #5b2ff5),
      linear-gradient(#5b2ff5, #5b2ff5),
      linear-gradient(#5b2ff5, #5b2ff5);
    background-repeat: no-repeat;
    background-position:
      left top,
      right top,
      right bottom,
      left bottom;
    background-size:
      100% 2px,
      2px 100%,
      100% 2px,
      2px 100%;
  }

  /* A: nessuno pseudo, solo un border. */
  .diag__box--a {
    border: 2px solid #5b2ff5;
  }

  .diag__box--a::after {
    content: none;
  }

  /* B: distanze scritte a mano. */
  .diag__box--b::after {
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
  }

  /* C: un calc su una variabile, senza altro dentro. */
  .diag__box--c {
    --sp: 2px;
  }

  .diag__box--c::after {
    top: 0;
    left: 0;
    right: calc(var(--sp) * 0);
    bottom: calc(var(--sp) * 0);
  }

  /* D: dentro al calc, una somma con una seconda variabile numerica. */
  .diag__box--d {
    --sp: 2px;
    --n: 0;
  }

  .diag__box--d::after {
    top: 0;
    left: 0;
    right: calc(var(--sp) * (0 + var(--n)));
    bottom: calc(var(--sp) * (0 + var(--n)));
  }

  /* E: la variabile numerica viene da un max() con un calc() dentro. */
  .diag__box--e {
    --sp: 2px;
    --col: 2;
    --c: 8;
    --cols: 10;
    --n: max(0, calc(var(--col) + var(--c) - var(--cols)));
  }

  .diag__box--e::after {
    top: 0;
    left: 0;
    right: calc(var(--sp) * (0 + var(--n)));
    bottom: calc(var(--sp) * (0 + var(--n)));
  }

  /* F: la regola vera del sito, con i suoi nomi e le sue variabili. */
  .diag__box--f {
    --line: 2px;
    --col: 2;
    --c: 8;
    --cols: 10;
    --rows: 20;
    --row: 2;
    --r: 2;
    --edge-x: max(0, calc(var(--col) + var(--c) - var(--cols)));
    --edge-y: max(0, calc(var(--row) + var(--r) - var(--rows)));
    border: var(--line) solid transparent;
  }

  .diag__box--f::after {
    top: calc(var(--line) * -1);
    left: calc(var(--line) * -1);
    right: calc(var(--line) * (-2 + var(--edge-x)));
    bottom: calc(var(--line) * (-2 + var(--edge-y)));
    background-size:
      var(--rule-t, 100%) var(--line),
      var(--line) var(--rule-r, 100%),
      var(--rule-b, 100%) var(--line),
      var(--line) var(--rule-l, 100%);
  }
</style>

<script>
  /*
   * Legge lo pseudo-elemento di ogni prova e scrive l'esito in chiaro.
   *
   * La misura che conta e' la **larghezza** dello pseudo: se una delle
   * distanze e' invalida diventa `auto`, e uno pseudo senza contenuto con due
   * lati liberi collassa a zero. Un contorno disegnato su zero pixel non si
   * vede, ed e' questa l'ipotesi.
   */
  const errori: string[] = [];
  const mostraErrori = () => {
    const box = document.querySelector('[data-errori]');
    if (box) box.textContent = errori.length === 0 ? 'nessuno' : errori.join('\n');
  };
  window.addEventListener('error', (e) => {
    errori.push(`${e.message} — ${e.filename}:${e.lineno}`);
    mostraErrori();
  });

  const misura = (el: Element) => {
    const s = getComputedStyle(el, '::after');
    return {
      larghezza: s.width,
      altezza: s.height,
      destra: s.right,
      basso: s.bottom,
      dimensioni: s.backgroundSize,
    };
  };

  for (const box of document.querySelectorAll<HTMLElement>('[data-prova]')) {
    const id = box.dataset.prova!;
    const out = document.querySelector(`[data-esito="${id}"]`);
    if (!out) continue;

    if (id === 'a') {
      out.textContent = `bordo: ${getComputedStyle(box).borderTopWidth} ${getComputedStyle(box).borderTopColor}`;
      continue;
    }

    const m = misura(box);
    const collassato = parseFloat(m.larghezza) < 1 || parseFloat(m.altezza) < 1;
    out.textContent =
      `${collassato ? '### COLLASSATO ###' : 'ok'}\n` +
      `larghezza ${m.larghezza} · altezza ${m.altezza}\n` +
      `destra ${m.destra} · basso ${m.basso}\n` +
      `background-size ${m.dimensioni}`;
  }

  const amb = document.querySelector('[data-ambiente]');
  if (amb) {
    const prova = document.createElement('div');
    prova.style.cssText = '--x: max(0, calc(2 + 8 - 10)); width: calc(10px * (2 + var(--x)))';
    document.body.append(prova);
    const larghezzaMax = getComputedStyle(prova).width;
    prova.remove();

    amb.textContent = [
      `userAgent: ${navigator.userAgent}`,
      `finestra: ${window.innerWidth}x${window.innerHeight} @${window.devicePixelRatio}x`,
      `@property registra: ${'registerProperty' in CSS ? 'si' : 'no'}`,
      `max() dentro calc(): larghezza ${larghezzaMax} (attesa 20px)`,
      `supporta overflow:clip: ${CSS.supports('overflow', 'clip') ? 'si' : 'no'}`,
    ].join('\n');
  }

  mostraErrori();
</script>
