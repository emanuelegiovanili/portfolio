---
/**
 * I testimonial.
 *
 * Struttura diversa per tier, e non di poco: a lg la riga dei nomi sta *dentro*
 * il contenitore bordato (266:1148 e' figlio di 266:1107), a md e base e' un
 * blocco separato sopra di esso. Qui la riga e' sempre un blocco a se', con una
 * posizione per ciascun tier: a lg cade sulla prima riga del contenitore, che
 * di conseguenza parte una riga piu' sotto. Il risultato in pagina e' identico,
 * senza dover duplicare il markup delle schede.
 *
 * Il numero di schede non e' fisso. Il Figma ne disegna quattro, in pagina ne
 * arrivano due (quelle con un testo vero: vedi `src/data/testimonials.ts` e
 * NOTES.md B13), e domani possono essere tre. La riga non lo sa in anticipo: si
 * divide le otto celle in parti uguali a md e lg, e a base mette una scheda per
 * riga. Le due misure che ne discendono — quante colonne prende ogni scheda,
 * quante righe e' alta la riga a base — escono da qui come custom property
 * inline, e il CSS le legge senza sapere quante schede ci sono.
 *
 * Le due guardie qui sotto sono il prezzo di quella liberta': se le schede non
 * dividono le colonne, o se a base non sono tante quante le righe del blocco,
 * la build si ferma invece di consegnare una riga storta.
 *
 * Il testo di ogni scheda viaggia sugli attributi della scheda stessa: al
 * server la lista la conosce gia' Astro, e al client serve solo poterla
 * rileggere quando si cambia scheda (`src/motion/testimonials.ts`).
 */
import Block from '../Block.astro';
import SquareButton from '../SquareButton.astro';
import type { BlockPlacements } from '../../lib/layout';
import type { Testimonial } from '../../data/testimonials';

interface Props {
  at: { row: BlockPlacements; details: BlockPlacements; prev?: BlockPlacements; next?: BlockPlacements };
  items: Testimonial[];
}

const { at, items } = Astro.props;

const firstComplete = items.findIndex((t) => t.quote);
const active = firstComplete >= 0 ? firstComplete : 0;
const shown = items[active];

const tabs = items.length;
// Le colonne sono le stesse a tutti e tre i tier (8); le righe cambiano.
const tabCols = at.row.base?.[2] ?? at.row.lg![2];
const rowsBase = at.row.base?.[3] ?? 1;

if (tabCols % tabs !== 0) {
  throw new Error(
    `testimonial: ${tabs} schede non dividono ${tabCols} colonne. ` +
      `Con parti disuguali i lati delle schede non cadono piu' sulle linee di griglia.`,
  );
}
if (at.row.base && rowsBase !== tabs) {
  throw new Error(
    `testimonial: a base la riga e' alta ${rowsBase} righe ma le schede sono ${tabs}. ` +
      `A base va una scheda per riga: aggiorna testimonialsRow in src/lib/blocks/home.ts, ` +
      `e con lui le righe dei blocchi che stanno sotto.`,
  );
}

const tabSpan = tabCols / tabs;
---

<Block
  at={at.row}
  class="testimonial-row"
  role="tablist"
  aria-label="Clienti"
  surface="bare"
  style={`--tab-cols:${tabCols};--tab-rows:${rowsBase}`}
>
  {
    items.map((item, i) => {
      return (
        <button
          class="testimonial-tab"
          type="button"
          role="tab"
          data-ruled
          id={`tt-${i}`}
          aria-controls="testimonial-panel"
          aria-selected={i === active ? 'true' : 'false'}
          style={`--tab-row-base:${i + 1};--tab-col-md:${i * tabSpan + 1};--tab-span-md:${tabSpan}`}
          tabindex={i === active ? 0 : -1}
          data-testimonial={i}
          data-quote={item.quote}
          data-author={item.author}
          data-role={item.role}
        >
          {item.client}
          {/* Una barra per scheda, non una sola sulla scheda attiva: e' il conto
              alla rovescia dei dieci secondi, e deve poter ripartire da zero su
              qualunque scheda diventi quella corrente. */}
          <span class="testimonial-tab__progress" aria-hidden="true" />
        </button>
      );
    })
  }
</Block>

<Block at={at.details} class="testimonials" clip>
  <div class="testimonial-details" id="testimonial-panel" role="tabpanel" aria-labelledby={`tt-${active}`}>
    <p class="testimonial-quote" data-testimonial-quote>{shown.quote}</p>
    <p class="testimonial-author">
      <span class="testimonial-author__name" data-testimonial-author>{shown.author}</span>
      <span class="testimonial-author__role" data-testimonial-role>{shown.role}</span>
    </p>
  </div>
</Block>

{at.prev && <SquareButton at={at.prev} icon="chevron-left" label="Testimonianza precedente" data-testimonial-prev />}
{at.next && <SquareButton at={at.next} icon="chevron-right" label="Testimonianza successiva" data-testimonial-next />}
