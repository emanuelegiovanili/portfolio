---
/**
 * Il carosello Selected Works.
 *
 * Una sola immagine 8x5 con paginazione e frecce. Lo scorrimento lo fa
 * `src/motion/carousel.ts`: senza JavaScript resta la prima slide, e le altre
 * non esistono nemmeno per lo screen reader.
 *
 * La paginazione e' calcolata dalla collection. Nel Figma dice "1/5" con tre
 * progetti in elenco: e' un numero rimasto indietro, vedi NOTES.md §3.2.
 */
import Block from '../Block.astro';
import WorkCard from '../WorkCard.astro';
import SquareButton from '../SquareButton.astro';
import type { BlockPlacements } from '../../lib/layout';
import type { CollectionEntry } from 'astro:content';

interface Props {
  at: { card: BlockPlacements; pagination: BlockPlacements; prev: BlockPlacements; next: BlockPlacements };
  works: CollectionEntry<'works'>[];
}

const { at, works } = Astro.props;
---

<Block at={at.card} class="works-card" data-carousel="works" clip>
  {/*
    Il ritaglio delle slide sta qui e non sul blocco.

    Il blocco concede al proprio filo due pixel oltre il padding box
    (`overflow-clip-margin`, grid.css), e in quei due pixel si vedrebbe
    spuntare la slide che esce. Questo contenitore ritaglia netto.
  */}
  <div class="works-card__viewport">
    {
      works.map((work, i) => (
        <a
          class="works-card__slide"
          href={`/works/${work.id}`}
          data-slide={i}
          hidden={i > 0}
          aria-hidden={i > 0 ? 'true' : undefined}
          tabindex={i > 0 ? -1 : undefined}
        >
          <WorkCard work={work} eager={i === 0} />
        </a>
      ))
    }
  </div>
</Block>

<Block at={at.pagination} class="works-pagination" data-carousel-count clip>
  <span data-carousel-current>1</span>/<span>{works.length}</span>
</Block>

<SquareButton
  at={at.prev}
  icon="chevron-left"
  label="Progetto precedente"
  class="works-arrow"
  data-carousel-prev
/>
<SquareButton at={at.next} icon="chevron-right" label="Progetto successivo" class="works-arrow" data-carousel-next />
