---
/**
 * Megamenu (268:1498).
 *
 * Sta fuori da #smooth-content, nello slot `fixed` di Base: ScrollSmoother
 * trasla il contenuto, e una trasformazione rende l'elemento traslato il
 * contenitore di riferimento dei propri discendenti in position: fixed. Dentro
 * al contenuto, il pannello smetterebbe di essere ancorato alla finestra.
 *
 * Nessuna griglia di sfondo: sul nero il file disegna solo i blocchi bordati,
 * quindi <Grid lines={false}>. I fili passano da --dark-grey a --off-white e il
 * fondo dei blocchi da mezzo off-white a niente: sono le uniche tre variabili
 * che cambiano, il resto del sistema e' lo stesso.
 *
 * L'apertura e la chiusura stanno in src/scripts/megamenu.ts. Senza JavaScript
 * il pannello resta chiuso e il bottone non fa niente: la navigazione vive
 * comunque nel footer, che e' su ogni pagina.
 */
import Grid from './Grid.astro';
import Block from './Block.astro';
import Icon from './Icon.astro';
import SquareButton from './SquareButton.astro';
import PrimaryButton from './PrimaryButton.astro';
import { megamenuMap, MENU_LINKS, MENU_SOCIALS } from '../lib/blocks/chrome';
import { DEFAULT_LOCALE, LOCALES, pathFor, type Locale } from '../i18n';
import { dizionario } from '../i18n/dizionario';

interface Props {
  locale?: Locale;
  /** Il percorso **inglese** della pagina, per restare sulla stessa cambiando lingua. */
  percorso?: string;
}

const { locale = DEFAULT_LOCALE, percorso } = Astro.props;
const t = dizionario(locale);
const via = (p: string) => pathFor(locale, p);

/*
 * I due comandi della lingua.
 *
 * Portano alla **stessa pagina** nell'altra lingua, non alla home: cambiare
 * lingua da /about e ritrovarsi sulla home e' il modo piu' rapido di far
 * perdere il segno a chi stava leggendo. Dove il percorso non lo sappiamo —
 * le route di debug — il comando non si disegna affatto, perche' un comando
 * che porta altrove e' peggio di nessun comando.
 *
 * Sono `<a>`, non bottoni: cambiano indirizzo. Chi apre in una scheda nuova,
 * chi copia il link, chi naviga da tastiera si aspetta un link e lo trova.
 */
const comandiLingua = percorso
  ? LOCALES.map((l) => ({
      locale: l,
      href: pathFor(l, percorso),
      etichetta: l === 'it' ? t.comune.lingua.it : t.comune.lingua.en,
      attiva: l === locale,
      at: l === 'it' ? megamenuMap.menuLangIt : megamenuMap.menuLangEn,
    }))
  : [];
---

<div
  id="megamenu"
  class="megamenu"
  role="dialog"
  aria-modal="true"
  aria-label={t.comune.intestazione.menu}
  aria-hidden="true"
  inert
>
  <div class="megamenu__panel">
    <div class="megamenu__inner">
      <Grid map={megamenuMap} lines={false} class="megamenu__grid">
        {/* Nel file e' un frame di testo, non un link. Qui porta a casa: il menu
            non ha una voce "Home" e un logo muto dentro una navigazione a tutto
            schermo e' un vicolo cieco. Vedi NOTES.md D48. */}
        <Block at={megamenuMap.menuLogo} as="a" href={via('/')} class="logo menu-logo" clip>
          <span class="t-display logo__text">
            <span class="logo__word">Emanuele</span> <span class="logo__word">Giovanili</span>
          </span>
        </Block>

        <PrimaryButton at={megamenuMap.menuCta} label={t.comune.menu.lavoriamo} href={via('/contact')} />

        {/*
          L'icona e' `menu`, non `x`.

          Questo bottone sta nella stessa cella della hamburger di pagina, e la
          tendina entrando da destra lo scopre per primo: a schermo e' lo stesso
          quadrato che non si e' mosso, con dentro la stessa icona che sta
          diventando una X. Il morph lo pilota `aria-expanded` della hamburger,
          che e' l'unico stato: le due icone non possono discordare.

          Superficie bordata come tutti gli altri blocchi: il filo, qui
          off-white come il resto del pannello, e' quello che lo tiene dentro
          la griglia. Il fondo e' nero al 50% sul nero del pannello, cioe' nero.

          L'hover ce l'ha come tutto il resto del pannello: riempimento
          off-white che sale dal basso. Prima era spento perche' la hamburger di
          pagina, sotto la tendina, deve restare nera: ma quella e' l'altro
          bottone, e i due stati non sono lo stesso stato.
        */}
        <SquareButton
          at={megamenuMap.menuClose}
          icon="menu"
          label={t.comune.intestazione.chiudiMenu}
          class="menu-close"
          id="menu-close"
          aria-controls="megamenu"
        />

        {
          MENU_LINKS.map((link) => (
            <Block at={megamenuMap[link.key]} as="a" class="menu-voice" href={via(link.href)} clip>
              <span class="t-display t-display--page">{t.comune.menu[link.voce]}</span>
              {/* La copia nel colore d'arrivo, come sui bottoni: e' lo strato che
                  sale a ritagliare se stesso e la propria scritta, cosi' il
                  testo cambia colore dove passa il bordo del riempimento. */}
              <span class="hover-fill" aria-hidden="true">
                <span class="t-display t-display--page">{t.comune.menu[link.voce]}</span>
              </span>
            </Block>
          ))
        }

        {
          comandiLingua.map((lingua) => (
            <Block
              at={lingua.at}
              as="a"
              class="menu-lang"
              href={lingua.href}
              hreflang={lingua.locale}
              lang={lingua.locale}
              aria-label={`${t.comune.lingua.etichetta}: ${lingua.etichetta}`}
              aria-current={lingua.attiva ? 'true' : undefined}
              data-attiva={lingua.attiva ? '' : undefined}
              clip
            >
              <span class="menu-lang__label">{lingua.etichetta}</span>
              {/* Il fondo viola dice quale lingua e' attiva, e il colore da solo
                  non lo dice a chi non lo vede: `aria-current` lo dice, e questo
                  lo pronuncia. */}
              {lingua.attiva && <span class="visually-hidden">, {t.comune.lingua.attiva}</span>}
            </Block>
          ))
        }

        {
          MENU_SOCIALS.map((social) => (
            <Block
              at={megamenuMap[social.key]}
              as="a"
              class="menu-social"
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              clip
            >
              <span class="t-link">{t.comune.menu[social.voce]}</span>
              <Icon name="arrow-up-right" />
              <span class="hover-fill" aria-hidden="true">
                <span class="t-link">{t.comune.menu[social.voce]}</span>
                <Icon name="arrow-up-right" />
              </span>
            </Block>
          ))
        }
      </Grid>
    </div>
  </div>
</div>
