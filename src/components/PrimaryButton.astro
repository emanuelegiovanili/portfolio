---
/**
 * Primary-button (314:2221). Fondo viola, nessun bordo, Getai Black 16px.
 *
 * Lo span cambia per tier e per punto d'uso: 2x1 a desktop, 3x1 a 767, 5x2 a
 * mobile, 4x1 nel footer. Non e' una proprieta' del componente, e' la mappa
 * della pagina a dirlo.
 *
 * Lo stato disabilitato usa --light-grey. Vedi NOTES.md D24.
 *
 * L'hover (314:2215) inverte: fondo off-white, testo nero. Il riempimento sale
 * dal basso e la scritta e' ripetuta dentro allo strato che sale, cosi' cambia
 * colore esattamente dove passa il bordo del riempimento. Su disabilitato non
 * parte: non c'e' niente da premere.
 */
import Block from './Block.astro';
import type { BlockPlacements } from '../lib/layout';

interface Props {
  at: BlockPlacements;
  label: string;
  href?: string;
  type?: 'button' | 'submit';
  disabled?: boolean;
  class?: string;
  [key: string]: unknown;
}

const { at, label, href, type = 'button', disabled = false, class: className, ...rest } = Astro.props;

const isLink = href !== undefined;
---

<Block
  at={at}
  as={isLink ? 'a' : 'button'}
  surface="accent"
  class:list={['primary-button', className]}
  href={href}
  type={isLink ? undefined : type}
  disabled={isLink ? undefined : disabled || undefined}
  {...rest}
>
  <span class="t-display t-display--button">{label}</span>
  <span class="hover-fill" aria-hidden="true">
    <span class="t-display t-display--button">{label}</span>
  </span>
</Block>
