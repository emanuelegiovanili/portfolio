---
/**
 * Footer.
 *
 * Nel Figma l'indicatore di link attivo e' sotto "Home" su tutte e cinque le
 * pagine, perche' il blocco e' stato ricopiato senza aggiornarne lo stato. Qui
 * discende dalla route corrente.
 *
 * A base la composizione cambia: sei voci invece di cinque, brand alto due
 * righe, e il "Let's work together" che scende a fondo pagina come bottone
 * invece di stare nella prima riga.
 */
import Block from './Block.astro';
import Icon from './Icon.astro';
import PrimaryButton from './PrimaryButton.astro';
import { FOOTER_LINKS } from '../lib/blocks/chrome';
import { SITE_NAME, isPlaceholder } from '../lib/site';
import type { LayoutMap } from '../lib/layout';

interface Props {
  /** La mappa restituita da footerMap(), gia' fusa in quella della pagina. */
  at: LayoutMap;
  /** Il path corrente, per l'indicatore di voce attiva. */
  current: string;
  /**
   * `flow` marca i blocchi che si spostano quando il filtro di /works cambia.
   *
   * Su quella pagina, nascondere una card fa salire di quattro righe tutto cio'
   * che sta sotto. Lo scostamento e' lo stesso per tutti, e il CSS della pagina
   * lo applica a `[data-flow]`: qui serve solo dire chi ne fa parte. Altrove
   * l'attributo non c'e' e non cambia niente.
   */
  flow?: boolean;
}

const { at, current, flow = false } = Astro.props;
const flowAttr = flow ? '' : undefined;

const WORK_TOGETHER = "Let’s work together";
---

{/* Porta a casa. Un nome grande a fondo pagina che non fa niente e' un vicolo
    cieco: e' la stessa scelta gia' presa per il logo in testa (NOTES.md D48). */}
<Block at={at.footerBrand!} as="a" href="/" class="footer-brand" data-flow={flowAttr} clip>
  <span class="t-display footer-brand__text">{SITE_NAME}</span>
  <span class="hover-fill" aria-hidden="true">
    <span class="t-display footer-brand__text">{SITE_NAME}</span>
  </span>
</Block>

{at.footerWorkTogether && <PrimaryButton at={at.footerWorkTogether} label={WORK_TOGETHER} href="/contact" data-flow={flowAttr} />}

{
  FOOTER_LINKS.map((link) => {
    const placement = at[link.key];
    if (!placement) return null;
    const isCurrent = !link.external && link.href === current;
    return (
      <Block
        at={placement}
        as="a"
        class:list={['footer-link', isCurrent && 'is-current']}
        href={link.href}
        aria-current={isCurrent ? 'page' : undefined}
        target={link.external ? '_blank' : undefined}
        rel={link.external ? 'noopener noreferrer' : undefined}
        aria-disabled={link.external && isPlaceholder(link.href) ? 'true' : undefined}
        data-flow={flowAttr}
        clip
      >
        {link.external && <Icon name="arrow-up-right" class="footer-link__arrow" />}
        <span class="footer-link__label">{link.label}</span>
        {isCurrent && <span class="footer-link__indicator" aria-hidden="true" />}
        {/* Lo strato copre anche la barra della pagina corrente, ed e' giusto:
            mentre punti una voce, quello che stai per fare conta piu' di dove
            sei. I social segnaposto non si accendono, perche' la regola
            dell'hover esclude `aria-disabled`. */}
        <span class="hover-fill" aria-hidden="true">
          {link.external && <Icon name="arrow-up-right" class="footer-link__arrow" />}
          <span class="footer-link__label">{link.label}</span>
        </span>
      </Block>
    );
  })
}

{at.footerCta && <PrimaryButton at={at.footerCta} label={WORK_TOGETHER} href="/contact" data-flow={flowAttr} />}
