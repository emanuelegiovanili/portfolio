---
import '../styles/tokens.css';
import '../styles/type.css';
import '../styles/grid.css';
import '../styles/components.css';
import MegaMenu from '../components/MegaMenu.astro';
import StickyHeader from '../components/StickyHeader.astro';
import { DEFAULT_LOCALE, HTML_LANG, alternates, type Locale } from '../i18n';

interface Props {
  title: string;
  description?: string;
  /** Tiene la pagina fuori dagli indici. Serve alle route di debug. */
  noindex?: boolean;
  locale?: Locale;
  /**
   * L'indirizzo **inglese** di questa pagina, con la barra iniziale.
   *
   * Da qui escono i due `hreflang`. Serve il percorso inglese e non quello
   * corrente perche' `pathFor` sa costruire l'altro da quello, non viceversa:
   * da `/it/about` si dovrebbe indovinare quanto togliere.
   */
  percorso?: string;
}

const { title, description, noindex = false, locale = DEFAULT_LOCALE, percorso } = Astro.props;

/*
 * I due indirizzi della stessa pagina, piu' `x-default`.
 *
 * Senza questi, un motore di ricerca vede due pagine che dicono la stessa cosa
 * in lingue diverse e non sa che sono la stessa: o le considera copie, o ne
 * mostra una a chi cercava l'altra. `x-default` punta all'inglese perche' e'
 * la lingua principale — la richiesta del committente — e perche' e' quella
 * senza prefisso.
 *
 * Le pagine di debug non passano `percorso` e restano senza: non devono
 * finire in nessun indice.
 */
const lingueAlternative = percorso ? alternates(percorso) : [];
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {
      lingueAlternative.map((alt) => (
        <link rel="alternate" hreflang={HTML_LANG[alt.locale]} href={alt.href} />
      ))
    }
    {percorso && <link rel="alternate" hreflang="x-default" href={percorso} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preload" href="/fonts/poppins-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/poppins-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/getai-black.woff2" as="font" type="font/woff2" crossorigin />

    {/*
      Il sipario, prima del primo fotogramma.

      Questo script deve stare qui, in `<head>`, e non nel modulo: se la pagina
      nuova aspettasse `transition.ts` per sapere di dover essere coperta, si
      vedrebbe per un istante prima che il sipario arrivi — che e' esattamente
      il lampo che il sipario serve a togliere.

      Fa tre cose e nient'altro: legge il segnale lasciato dalla pagina
      precedente, lo consuma, e alza comunque il sipario dopo un secondo e
      mezzo. Quel terzo punto e' il ripiego: se il modulo non arriva — rete
      caduta, errore in un altro script — la pagina resta coperta per un
      secondo e mezzo invece che per sempre.

      `sessionStorage` puo' lanciare in modalita' privata: il try/catch non e'
      pignoleria, e senza si romperebbe il caricamento di ogni pagina.
    */}
    <script is:inline>
      (function () {
        try {
          var arrivo = sessionStorage.getItem('sipario') === '1';
          sessionStorage.removeItem('sipario');
          if (!arrivo) return;
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          var radice = document.documentElement;
          radice.dataset.sipario = 'entra';
          setTimeout(function () {
            if (radice.dataset.sipario === 'entra') delete radice.dataset.sipario;
          }, 1500);
        } catch (e) {
          /* Niente sipario, e la pagina si vede: e' il ripiego giusto. */
        }
      })();
    </script>
  </head>
  <body>
    {/* Primo figlio del body: deve esistere presto, perche' e' quello che si
        vede mentre il resto della pagina si compone. */}
    <div class="sipario" aria-hidden="true"></div>

    {/*
      La struttura che ScrollSmoother si aspetta. I due elementi non hanno stile
      proprio: li imposta ScrollSmoother a runtime, e se il JavaScript non
      arriva la pagina scorre in modo nativo senza che nulla sia fuori posto.

      Tutto cio' che e' in position: fixed va **fuori** da #smooth-content: il
      contenuto viene traslato, e una trasformazione lo rende il contenitore di
      riferimento dei suoi discendenti fissi, che smetterebbero di essere
      ancorati alla finestra.
    */}
    <div id="smooth-wrapper">
      <div id="smooth-content">
        <slot />
      </div>
    </div>

    <MegaMenu locale={locale} percorso={percorso} />
    <StickyHeader locale={locale} />
    <slot name="fixed" />

    <script>
      import '../scripts/transition';
      import '../scripts/motion';
      import '../scripts/megamenu';
      import '../scripts/sticky-header';
      import '../scripts/icons';
    </script>
  </body>
</html>
