---
import '../styles/tokens.css';
import '../styles/type.css';
import '../styles/grid.css';
import '../styles/components.css';
import MegaMenu from '../components/MegaMenu.astro';

interface Props {
  title: string;
  description?: string;
  /** Tiene la pagina fuori dagli indici. Serve alle route di debug. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preload" href="/fonts/poppins-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/poppins-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/getai-black.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    {/*
      La struttura che ScrollSmoother si aspetta. I due elementi non hanno stile
      proprio: li imposta ScrollSmoother a runtime, e se il JavaScript non
      arriva la pagina scorre in modo nativo senza che nulla sia fuori posto.

      Tutto cio' che e' in position: fixed va **fuori** da #smooth-content: il
      contenuto viene traslato, e una trasformazione lo rende il contenitore di
      riferimento dei suoi discendenti fissi, che smetterebbero di essere
      ancorati alla finestra.
    */}
    <div id="smooth-wrapper">
      <div id="smooth-content">
        <slot />
      </div>
    </div>

    <MegaMenu />
    <slot name="fixed" />

    <script>
      import '../scripts/motion';
      import '../scripts/megamenu';
      import '../scripts/icons';
    </script>
  </body>
</html>
